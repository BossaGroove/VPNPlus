    "Connecting to %@ failed while checking the server's certificate, and this Mac's clock is behind a time it has already recorded. That alone can cause this.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to %@ failed while checking the server's certificate, and this Mac's clock is behind a time it has already recorded. That alone can cause this."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung mit %@ scheiterte beim Prüfen des Serverzertifikats, und die Uhr dieses Macs liegt hinter einer Zeit, die er bereits aufgezeichnet hat. Das allein kann die Ursache sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ a échoué lors de la vérification du certificat du serveur, et l'horloge de ce Mac est en retard sur une heure qu'il a déjà enregistrée. Cela seul peut en être la cause."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ への接続はサーバー証明書の確認中に失敗し、この Mac の時計は以前に記録した時刻より遅れています。それだけでこの問題が起こることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 %@ 时在检查服务器证书阶段失败，而这台 Mac 的时钟落后于它已记录过的时间。仅这一点就可能导致此问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線 %@ 時在檢查伺服器憑證階段失敗，而這台 Mac 的時鐘落後於它已記錄過的時間。單憑這一點就可能造成此問題。"
          }
        }
      }
    },
