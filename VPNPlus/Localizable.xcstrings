            "value": "Ce profil s'identifie tout seul. Aucun nom d'utilisateur ni mot de passe requis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルは自動でサインインします。ユーザ名やパスワードは不要です。"
          }
        },
        "zh-Hans": {
