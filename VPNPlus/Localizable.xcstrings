            "value": "新檔案不再提供你先前選擇的 %@。"
          }
        }
      }
    },
    "The new language takes effect when VPN Plus starts again. Nothing else changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new language takes effect when VPN Plus starts again. Nothing else changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache gilt, wenn VPN Plus neu startet. Sonst ändert sich nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue prend effet au redémarrage de VPN Plus. Rien d'autre ne change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語は VPN Plus の再起動後に有効になります。それ以外は何も変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
