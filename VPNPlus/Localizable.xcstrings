    "System Settings should be open. Turn on VPN Plus there, then come back — this window will notice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings should be open. Turn on VPN Plus there, then come back — this window will notice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemeinstellungen sollten offen sein. Schalte dort VPN Plus ein und komm zurück – dieses Fenster merkt es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Système devrait être ouvert. Activez-y VPN Plus, puis revenez : cette fenêtre s'en apercevra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定が開いているはずです。そこで VPN Plus をオンにして戻ってきてください。このウインドウが自動的に検知します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统设置”应该已经打开。请在那里开启 VPN Plus，然后回到这里——此窗口会自动察觉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「系統設定」應該已經打開。請在那裡開啟 VPN Plus，然後回到這裡——此視窗會自動察覺。"
          }
        }
      }
    },
