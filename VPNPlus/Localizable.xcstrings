    "A management policy on this Mac blocks VPN Plus's network component, so it can't connect. Ask whoever manages this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A management policy on this Mac blocks VPN Plus's network component, so it can't connect. Ask whoever manages this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Verwaltungsrichtlinie auf diesem Mac blockiert die Netzwerkkomponente von VPN Plus, deshalb kann es nicht verbinden. Frag, wer diesen Mac verwaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle de gestion sur ce Mac bloque le composant réseau de VPN Plus, qui ne peut donc pas se connecter. Demandez à la personne qui gère ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の管理ポリシーが VPN Plus のネットワークコンポーネントをブロックしているため、接続できません。この Mac の管理者に問い合わせてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的管理策略阻止了 VPN Plus 的网络组件，因此无法连接。请联系这台 Mac 的管理者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上的管理政策封鎖了 VPN Plus 的網路元件，因此無法連線。請聯絡這台 Mac 的管理者。"
          }
        }
      }
    },
