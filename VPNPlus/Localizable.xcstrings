    "The server's address couldn't be looked up. This is usually a problem with the network you're on rather than with the VPN.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's address couldn't be looked up. This is usually a problem with the network you're on rather than with the VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse des Servers konnte nicht aufgelöst werden. Das liegt meist am Netzwerk, in dem du bist, nicht am VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse du serveur n'a pas pu être résolue. C'est généralement un problème du réseau où vous êtes plutôt que du VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのアドレスを解決できませんでした。通常、VPN ではなく現在のネットワーク側の問題です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
