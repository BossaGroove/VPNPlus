        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用该证书"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用該憑證"
          }
        }
      }
    },
    "The certificate or key this profile needs couldn't be read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate or key this profile needs couldn't be read."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat oder der Schlüssel, den dieses Profil braucht, konnte nicht gelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat ou la clé dont ce profil a besoin n'a pas pu être lu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルに必要な証明書または鍵を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此配置所需的证书或密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此描述檔所需的憑證或金鑰。"
          }
        }
      }
    },
    "The connection couldn't begin because the part of VPN Plus that carries traffic didn't start on this Mac. VPN Plus tried twice. Try again, and if it keeps happening, restart your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection couldn't begin because the part of VPN Plus that carries traffic didn't start on this Mac. VPN Plus tried twice. Try again, and if it keeps happening, restart your Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung konnte nicht beginnen, weil der Teil von VPN Plus, der den Verkehr leitet, auf diesem Mac nicht gestartet ist. VPN Plus hat es zweimal versucht. Versuche es erneut, und wenn es weiter passiert, starte deinen Mac neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n'a pas pu commencer parce que la partie de VPN Plus qui achemine le trafic n'a pas démarré sur ce Mac. VPN Plus a essayé deux fois. Réessayez, et si cela continue, redémarrez votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信を担う VPN Plus のコンポーネントがこの Mac で起動しなかったため、接続を開始できませんでした。VPN Plus は 2 回試しました。もう一度お試しください。繰り返す場合は Mac を再起動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始连接，因为 VPN Plus 中负责传输流量的部分未能在这台 Mac 上启动。VPN Plus 已尝试两次。请再试一次；如果持续出现，请重新启动 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開始連線，因為 VPN Plus 中負責傳輸流量的部分未能在這台 Mac 上啟動。VPN Plus 已嘗試兩次。請再試一次；如果持續發生，請重新啟動 Mac。"
          }
        }
      }
    },
    "The connection dropped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped"
          }
        },
        "de": {
