    "%@ asks for a feature that isn't available. It's worth reporting — we'd like to know which profiles need it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks for a feature that isn't available. It's worth reporting — we'd like to know which profiles need it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verlangt eine Funktion, die nicht verfügbar ist. Das lohnt sich zu melden – wir möchten wissen, welche Profile sie brauchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande une fonction qui n'est pas disponible. Cela vaut la peine de le signaler : nous aimerions savoir quels profils en ont besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は利用できない機能を求めています。報告する価値があります。どのプロファイルにそれが必要かを知りたいと考えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要一个尚不可用的功能。值得反馈——我们想知道哪些配置需要它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要一項尚未提供的功能。值得回報——我們想知道哪些描述檔需要它。"
          }
        }
      }
    },
    "%@ connected, but the network settings couldn't be applied on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connected, but the network settings couldn't be applied on this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde verbunden, aber die Netzwerkeinstellungen konnten auf diesem Mac nicht übernommen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'est connecté, mais les réglages réseau n'ont pas pu être appliqués sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は接続しましたが、この Mac にネットワーク設定を適用できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接，但网络设置无法在这台 Mac 上应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連線，但網路設定無法套用到這台 Mac。"
          }
        }
      }
    },
    "%@ connects to a network this Mac is already on. Connecting anyway can stop other things working until you disconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connects to a network this Mac is already on. Connecting anyway can stop other things working until you disconnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verbindet mit einem Netzwerk, in dem sich dieser Mac bereits befindet. Trotzdem zu verbinden kann andere Dinge lahmlegen, bis du die Verbindung trennst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se connecte à un réseau auquel ce Mac est déjà connecté. Se connecter quand même peut empêcher d'autres choses de fonctionner jusqu'à la déconnexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、この Mac がすでに参加しているネットワークに接続します。このまま接続すると、切断するまで他の動作が止まることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要连接的网络正是这台 Mac 所在的网络。仍然连接可能导致其他功能无法使用，直到你断开连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要連線的網路正是這台 Mac 所在的網路。仍然連線可能會讓其他功能停擺，直到你中斷連線。"
          }
        }
      }
    },
    "%@ couldn't be read as a VPN profile. If it came in an archive or an email, check that it arrived complete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't be read as a VPN profile. If it came in an archive or an email, check that it arrived complete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht als VPN-Profil gelesen werden. Falls es in einem Archiv oder einer E-Mail kam, prüfe, ob es vollständig angekommen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas pu être lu comme profil VPN. S'il est arrivé dans une archive ou un e-mail, vérifiez qu'il est complet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を VPN プロファイルとして読み込めませんでした。アーカイブやメールで届いた場合は、完全な状態で届いているか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将 %@ 读取为 VPN 配置。如果它来自压缩包或电子邮件，请检查是否完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將 %@ 讀取為 VPN 描述檔。如果它來自壓縮檔或電子郵件，請檢查是否完整。"
          }
        }
      }
    },
    "%@ expects its certificate and key in a separate file that VPN Plus doesn't open yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expects its certificate and key in a separate file that VPN Plus doesn't open yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erwartet Zertifikat und Schlüssel in einer separaten Datei, die VPN Plus noch nicht öffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ attend son certificat et sa clé dans un fichier séparé que VPN Plus n'ouvre pas encore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は証明書と鍵を別のファイルに置いていますが、VPN Plus はまだそのファイルを開けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的证书和密钥位于单独的文件中，VPN Plus 尚不支持打开该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的憑證和金鑰位於另一個檔案中，VPN Plus 尚不支援開啟該檔案。"
          }
        }
      }
    },
    "%@ expects to be given the rest of its settings by your server after you sign in, which VPN Plus doesn't do yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expects to be given the rest of its settings by your server after you sign in, which VPN Plus doesn't do yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erwartet, die übrigen Einstellungen nach der Anmeldung vom Server zu erhalten, was VPN Plus noch nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'attend à recevoir le reste de ses réglages du serveur après la connexion, ce que VPN Plus ne fait pas encore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はサインイン後に残りの設定をサーバーから受け取る想定ですが、VPN Plus はまだそれに対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要在登录后由服务器提供其余设置，VPN Plus 尚不支持这种方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要在登入後由伺服器提供其餘設定，VPN Plus 尚不支援這種方式。"
          }
        }
      }
    },
    "%@ has a certificate but no private key. VPN Plus needs both, in the one file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a certificate but no private key. VPN Plus needs both, in the one file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält ein Zertifikat, aber keinen privaten Schlüssel. VPN Plus braucht beides in derselben Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contient un certificat mais pas de clé privée. VPN Plus a besoin des deux, dans le même fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には証明書はありますが秘密鍵がありません。VPN Plus には両方が同じファイル内に必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 包含证书但没有私钥。VPN Plus 需要两者位于同一文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 包含憑證但沒有私密金鑰。VPN Plus 需要兩者位於同一檔案中。"
          }
        }
      }
    },
    "%@ has no certificate in it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no certificate in it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält kein Zertifikat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne contient aucun certificat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には証明書が含まれていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中没有证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中沒有憑證。"
          }
        }
      }
    },
    "%@ is a keystore, which VPN Plus can't open. Ask for the certificate and key as a PEM file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a keystore, which VPN Plus can't open. Ask for the certificate and key as a PEM file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein Keystore, den VPN Plus nicht öffnen kann. Bitte um Zertifikat und Schlüssel als PEM-Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un keystore, que VPN Plus ne peut pas ouvrir. Demandez le certificat et la clé sous forme de fichier PEM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はキーストアで、VPN Plus では開けません。証明書と鍵を PEM ファイルとして依頼してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是密钥库，VPN Plus 无法打开。请索取 PEM 格式的证书和密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是金鑰庫，VPN Plus 無法開啟。請索取 PEM 格式的憑證和金鑰。"
          }
        }
      }
    },
    "%@ isn't a PEM file. A certificate VPN Plus can use begins with BEGIN CERTIFICATE.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't a PEM file. A certificate VPN Plus can use begins with BEGIN CERTIFICATE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist keine PEM-Datei. Ein Zertifikat, das VPN Plus verwenden kann, beginnt mit BEGIN CERTIFICATE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas un fichier PEM. Un certificat utilisable par VPN Plus commence par BEGIN CERTIFICATE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は PEM ファイルではありません。VPN Plus で使える証明書は BEGIN CERTIFICATE で始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是 PEM 文件。VPN Plus 可用的证书以 BEGIN CERTIFICATE 开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
