    "VPN Plus doesn't have a specific reason for it. Trying again is worth a go.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus doesn't have a specific reason for it. Trying again is worth a go."
          }
        },
