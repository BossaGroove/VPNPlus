    },
    "The server didn't respond. It may be down, or this network may be blocking the connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't respond. It may be down, or this network may be blocking the connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht geantwortet. Er ist vielleicht nicht erreichbar, oder dieses Netzwerk blockiert die Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas répondu. Il est peut-être hors service, ou ce réseau bloque peut-être la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが応答しませんでした。停止しているか、このネットワークが接続をブロックしている可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无响应。它可能已停机，或此网络阻止了连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器沒有回應。它可能已停機，或此網路封鎖了連線。"
          }
        }
      }
    },
