      }
    },
    "This profile's file was replaced since it last connected. If the new file changed the server or the sign-in, that is the first thing to check.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile's file was replaced since it last connected. If the new file changed the server or the sign-in, that is the first thing to check."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei dieses Profils wurde seit der letzten Verbindung ersetzt. Falls die neue Datei den Server oder die Anmeldung geändert hat, ist das zuerst zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de ce profil a été remplacé depuis sa dernière connexion. Si le nouveau fichier a changé le serveur ou les identifiants, c'est la première chose à vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の接続以降、このプロファイルのファイルが置き換えられました。新しいファイルでサーバーやサインインが変わっていれば、まずそこを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次连接以来，此配置的文件已被替换。如果新文件更改了服务器或登录信息，应首先检查这一点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次連線以來，此描述檔的檔案已被取代。如果新檔案更改了伺服器或登入資訊，應先檢查這一點。"
          }
        }
      }
    },
    "This profile's key needs a passphrase to unlock it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile's key needs a passphrase to unlock it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel dieses Profils braucht eine Passphrase zum Entsperren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de ce profil a besoin d'une phrase secrète pour être déverrouillée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルの鍵を解除するにはパスフレーズが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置的密钥需要口令才能解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此描述檔的金鑰需要密語才能解鎖。"
          }
        }
      }
    },
