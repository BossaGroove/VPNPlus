    "Your %@ override (%@) no longer matches the file, which now says %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ override (%2$@) no longer matches the file, which now says %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderung für %1$@ (%2$@) passt nicht mehr zur Datei, die jetzt %3$@ sagt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réglage de %1$@ (%2$@) ne correspond plus au fichier, qui indique maintenant %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの %1$@ の設定(%2$@)はファイルと一致しなくなりました。ファイルは現在 %3$@ です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你对 %1$@ 的自定义设置（%2$@）与文件不再一致，文件现在为 %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你對 %1$@ 的自訂設定（%2$@）與檔案不再一致，檔案現在為 %3$@。"
          }
        }
      }
