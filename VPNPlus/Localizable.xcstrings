    "VPN Plus is running from %@. macOS won't let it create a VPN connection from there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus is running from %@. macOS won't let it create a VPN connection from there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus läuft aus %@. macOS lässt es von dort keine VPN-Verbindung erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus s'exécute depuis %@. macOS ne le laisse pas créer une connexion VPN depuis là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus は%@から実行されています。macOS はそこからの VPN 接続の作成を許可しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 正从%@运行。macOS 不允许它从那里创建 VPN 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 正從%@執行。macOS 不允許它從那裡建立 VPN 連線。"
          }
        }
      }
    },
    "VPN Plus needs a .ovpn configuration file to connect. These usually come from your employer, a VPN provider, or your own server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus needs a .ovpn configuration file to connect. These usually come from your employer, a VPN provider, or your own server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus braucht eine .ovpn-Konfigurationsdatei, um zu verbinden. Sie kommt meist vom Arbeitgeber, einem VPN-Anbieter oder deinem eigenen Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus a besoin d'un fichier de configuration .ovpn pour se connecter. Il vient généralement de votre employeur, d'un fournisseur VPN ou de votre propre serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus は接続に .ovpn 設定ファイルを必要とします。通常、勤務先、VPN プロバイダ、または自分のサーバーから入手します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 需要 .ovpn 配置文件才能连接。它通常来自你的雇主、VPN 服务商或你自己的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 需要 .ovpn 設定檔才能連線。它通常來自你的雇主、VPN 服務商或你自己的伺服器。"
          }
        }
      }
    },
