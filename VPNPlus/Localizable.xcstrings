          "stringUnit": {
            "state": "translated",
            "value": "新檔案不允許儲存密碼。"
          }
        }
      }
    },
    "The new file fixes the username to %@; yours was %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new file fixes the username to %1$@; yours was %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Datei legt den Benutzernamen auf %1$@ fest; deiner war %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau fichier fixe le nom d'utilisateur à %1$@ ; le vôtre était %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいファイルはユーザ名を %1$@ に固定しています。あなたの設定は %2$@ でした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件将用户名固定为 %1$@；你的设置是 %2$@。"
