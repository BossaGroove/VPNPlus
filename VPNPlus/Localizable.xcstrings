      }
    },
    "%@ connected, but the network settings couldn't be applied on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connected, but the network settings couldn't be applied on this Mac."
          }
        }
      }
    },
    "%@ connects to a network this Mac is already on. Connecting anyway can stop other things working until you disconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connects to a network this Mac is already on. Connecting anyway can stop other things working until you disconnect."
          }
        }
      }
    },
    "%@ couldn't be read as a VPN profile. If it came in an archive or an email, check that it arrived complete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't be read as a VPN profile. If it came in an archive or an email, check that it arrived complete."
          }
        }
      }
    },
    "%@ expects its certificate and key in a separate file that VPN Plus doesn't open yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expects its certificate and key in a separate file that VPN Plus doesn't open yet."
          }
        }
      }
    },
    "%@ expects to be given the rest of its settings by your server after you sign in, which VPN Plus doesn't do yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expects to be given the rest of its settings by your server after you sign in, which VPN Plus doesn't do yet."
          }
        }
      }
    },
    "%@ has a certificate but no private key. VPN Plus needs both, in the one file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a certificate but no private key. VPN Plus needs both, in the one file."
          }
        }
      }
    },
    "%@ has no certificate in it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no certificate in it."
          }
        }
      }
    },
    "%@ is a keystore, which VPN Plus can't open. Ask for the certificate and key as a PEM file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a keystore, which VPN Plus can't open. Ask for the certificate and key as a PEM file."
          }
        }
      }
    },
    "%@ isn't a PEM file. A certificate VPN Plus can use begins with BEGIN CERTIFICATE.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't a PEM file. A certificate VPN Plus can use begins with BEGIN CERTIFICATE."
