    "VPN Plus can't find that profile's original file any more. The profile still works — it is the file that has moved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus can't find that profile's original file any more. The profile still works — it is the file that has moved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus findet die ursprüngliche Datei dieses Profils nicht mehr. Das Profil funktioniert weiterhin – nur die Datei wurde bewegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus ne trouve plus le fichier d'origine de ce profil. Le profil fonctionne toujours ; c'est le fichier qui a été déplacé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus はこのプロファイルの元のファイルを見つけられません。プロファイル自体は動作します。移動したのはファイルの方です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 找不到该配置的原始文件了。配置仍然可用——是文件被移动了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 找不到該描述檔的原始檔案了。描述檔仍然可用——是檔案被移動了。"
          }
        }
      }
    },
    "VPN Plus couldn't forget your saved password. It may still be able to connect on its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus couldn't forget your saved password. It may still be able to connect on its own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus konnte dein gesichertes Passwort nicht vergessen. Es kann sich möglicherweise weiterhin selbst verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus n'a pas pu oublier votre mot de passe enregistré. Il pourrait encore se connecter tout seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus は保存済みパスワードを削除できませんでした。引き続き自動で接続できる可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 无法删除已保存的密码。它可能仍然可以自行连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 無法刪除已儲存的密碼。它可能仍然可以自行連線。"
          }
        }
      }
    },
