    },
    "VPN Plus couldn't save your password. This connection will still work; the next one will ask for it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus couldn't save your password. This connection will still work; the next one will ask for it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus konnte dein Passwort nicht sichern. Diese Verbindung funktioniert trotzdem; die nächste fragt erneut danach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus n'a pas pu enregistrer votre mot de passe. Cette connexion fonctionnera quand même ; la prochaine le redemandera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus はパスワードを保存できませんでした。この接続は動作しますが、次回は再度入力を求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 无法保存你的密码。本次连接仍可使用；下次连接会再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 無法儲存你的密碼。本次連線仍可使用；下次連線會再次詢問。"
          }
        }
      }
    },
    "VPN Plus couldn't store that certificate. The profile still works, using whatever certificate it carries.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus couldn't store that certificate. The profile still works, using whatever certificate it carries."
