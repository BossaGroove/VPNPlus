        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新檔案將使用者名稱固定為 %1$@；你的設定是 %2$@。"
          }
        }
      }
    },
    "The new file no longer offers %@, which you had chosen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new file no longer offers %@, which you had chosen."
          }
        },
