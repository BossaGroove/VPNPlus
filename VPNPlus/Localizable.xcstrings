    "VPN Plus doesn't have permission from macOS to create a VPN connection, so it can't connect yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus doesn't have permission from macOS to create a VPN connection, so it can't connect yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus hat von macOS keine Erlaubnis, eine VPN-Verbindung zu erstellen, deshalb kann es noch nicht verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus n'a pas l'autorisation de macOS pour créer une connexion VPN, il ne peut donc pas encore se connecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus には VPN 接続を作成する macOS の許可がないため、まだ接続できません。"
