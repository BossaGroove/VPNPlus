        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Aufzeichnung der letzten Verbindung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la trace de sa dernière connexion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回接続した日時の記録"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次连接时间的记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次連線時間的記錄"
          }
        }
      }
    },
    "the same network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the same network"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dasselbe Netzwerk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le même réseau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じネットワーク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一网络"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一網路"
          }
        }
      }
    },
    "The server accepted your sign-in, then never sent the connection settings. That usually means a policy on the server refused this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server accepted your sign-in, then never sent the connection settings. That usually means a policy on the server refused this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat deine Anmeldung angenommen, aber nie die Verbindungseinstellungen gesendet. Das bedeutet meist, dass eine Richtlinie auf dem Server dieses Gerät abgelehnt hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a accepté votre identification, puis n'a jamais envoyé les réglages de connexion. Cela signifie généralement qu'une règle du serveur a refusé cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはサインインを受け付けましたが、接続設定を送ってきませんでした。通常、サーバーのポリシーがこのデバイスを拒否したことを意味します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器接受了你的登录，但没有发送连接设置。这通常意味着服务器上的策略拒绝了这台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器接受了你的登入，但沒有傳送連線設定。這通常表示伺服器上的政策拒絕了這台裝置。"
          }
        }
      }
    },
    "The server and sign-in details are the same as before. Certificates, keys and options aren't compared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server and sign-in details are the same as before. Certificates, keys and options aren't compared."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server und Anmeldedaten sind wie zuvor. Zertifikate, Schlüssel und Optionen werden nicht verglichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur et les identifiants sont les mêmes qu'avant. Les certificats, clés et options ne sont pas comparés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーとサインイン情報は以前と同じです。証明書、鍵、オプションは比較しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器和登录信息与之前相同。证书、密钥和选项不作比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器和登入資訊與先前相同。憑證、金鑰和選項不作比較。"
          }
        }
      }
    },
    "The server closed the connection without saying why.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server closed the connection without saying why."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Verbindung geschlossen, ohne einen Grund zu nennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a fermé la connexion sans dire pourquoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーは理由を告げずに接続を閉じました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器关闭了连接，未说明原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器關閉了連線，未說明原因。"
          }
        }
      }
    },
    "The server closes connections that have been idle for a while.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server closes connections that have been idle for a while."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server schließt Verbindungen, die eine Weile inaktiv waren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ferme les connexions inactives depuis un moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーは一定時間アイドル状態の接続を閉じます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器会关闭空闲一段时间的连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器會關閉閒置一段時間的連線。"
          }
        }
      }
    },
    "The server didn't accept your username or password. If they're definitely right, the account may be disabled or locked — worth asking whoever runs this VPN.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't accept your username or password. If they're definitely right, the account may be disabled or locked — worth asking whoever runs this VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat deinen Benutzernamen oder dein Passwort nicht akzeptiert. Wenn beide sicher stimmen, ist das Konto vielleicht deaktiviert oder gesperrt – frag am besten, wer dieses VPN betreibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas accepté votre nom d'utilisateur ou votre mot de passe. S'ils sont certainement corrects, le compte est peut-être désactivé ou verrouillé ; demandez à la personne qui gère ce VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはユーザ名またはパスワードを受け付けませんでした。確実に正しい場合は、アカウントが無効化またはロックされている可能性があります。この VPN の運用者に問い合わせてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不接受你的用户名或密码。如果确定无误，账户可能已被停用或锁定——请联系此 VPN 的运维人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器不接受你的使用者名稱或密碼。如果確定無誤，帳號可能已被停用或鎖定——請聯絡此 VPN 的維運人員。"
          }
        }
      }
    },
    "The server didn't respond": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't respond"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht geantwortet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas répondu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが応答しませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无响应"
          }
        },
        "zh-Hant": {
