            "value": "the profile"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "das Profil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le profil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此描述檔"
          }
        }
      }
    },
    "The profile was read, but VPN Plus couldn't save it. Your Keychain may have denied access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile was read, but VPN Plus couldn't save it. Your Keychain may have denied access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil wurde gelesen, aber VPN Plus konnte es nicht sichern. Möglicherweise hat dein Schlüsselbund den Zugriff verweigert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil a été lu, mais VPN Plus n'a pas pu l'enregistrer. Votre trousseau a peut-être refusé l'accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルは読み込めましたが、VPN Plus は保存できませんでした。キーチェーンがアクセスを拒否した可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已读取，但 VPN Plus 无法保存。可能是钥匙串拒绝了访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述檔已讀取，但 VPN Plus 無法儲存。可能是鑰匙圈拒絕了存取。"
          }
        }
      }
    },
    "The profile was read, but VPN Plus couldn't store it. Your Keychain may have denied access, and the old profile is still in place.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile was read, but VPN Plus couldn't store it. Your Keychain may have denied access, and the old profile is still in place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil wurde gelesen, aber VPN Plus konnte es nicht speichern. Möglicherweise hat dein Schlüsselbund den Zugriff verweigert; das alte Profil ist noch da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil a été lu, mais VPN Plus n'a pas pu le stocker. Votre trousseau a peut-être refusé l'accès ; l'ancien profil est toujours en place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルは読み込めましたが、VPN Plus は保存できませんでした。キーチェーンがアクセスを拒否した可能性があり、以前のプロファイルはそのまま残っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已读取，但 VPN Plus 无法存储。可能是钥匙串拒绝了访问，旧配置仍然保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述檔已讀取，但 VPN Plus 無法儲存。可能是鑰匙圈拒絕了存取，舊描述檔仍然保留。"
          }
        }
      }
    },
    "the record of when it last connected": {
