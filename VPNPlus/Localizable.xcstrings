        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat von %@ ist abgelaufen. Nur die Betreiber des Servers können es erneuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de sécurité de %@ a expiré. Seuls les responsables du serveur peuvent le renouveler."
