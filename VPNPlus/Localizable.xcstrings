    },
    "The connection stopped while %@, and VPN Plus doesn't have a specific reason for it. Trying again is worth a go.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection stopped while %@, and VPN Plus doesn't have a specific reason for it. Trying again is worth a go."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung brach beim Schritt „%@“ ab, und VPN Plus hat keinen konkreten Grund dafür. Ein neuer Versuch lohnt sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion s'est arrêtée pendant l'étape « %@ », et VPN Plus n'a pas de raison précise. Cela vaut la peine de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の途中で接続が停止しましたが、VPN Plus には具体的な理由がわかりません。もう一度試す価値はあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接在“%@”阶段停止，VPN Plus 没有具体原因。值得再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線在「%@」階段停止，VPN Plus 沒有具體原因。值得再試一次。"
          }
        }
      }
    },
