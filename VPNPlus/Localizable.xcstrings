          }
        }
      }
    },
    "The original .ovpn file on your Mac is not touched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original .ovpn file on your Mac is not touched."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche .ovpn-Datei auf deinem Mac bleibt unangetastet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier .ovpn d'origine sur votre Mac n'est pas touché."
          }
