    },
    "macOS didn't allow access to the saved password. You can enter it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn't allow access to the saved password. You can enter it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Zugriff auf das gesicherte Passwort nicht erlaubt. Du kannst es erneut eingeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas autorisé l'accès au mot de passe enregistré. Vous pouvez le saisir à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が保存済みパスワードへのアクセスを許可しませんでした。もう一度入力できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许访问已保存的密码。你可以重新输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允許存取已儲存的密碼。你可以重新輸入。"
          }
        }
      }
    },
    "macOS didn't allow it. You can add or remove VPN Plus under Login Items in System Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn't allow it. You can add or remove VPN Plus under Login Items in System Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat es nicht erlaubt. Du kannst VPN Plus in den Systemeinstellungen unter „Anmeldeobjekte“ hinzufügen oder entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ne l'a pas autorisé. Vous pouvez ajouter ou retirer VPN Plus sous Ouverture dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が許可しませんでした。システム設定の「ログイン項目」で VPN Plus を追加または削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许此操作。你可以在“系统设置”的“登录项”中添加或移除 VPN Plus。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允許此操作。你可以在「系統設定」的「登入項目」中加入或移除 VPN Plus。"
          }
        }
      }
    },
    "macOS didn't allow the copy into your Applications folder. Drag VPN Plus there yourself, then open it from there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn't allow the copy into your Applications folder. Drag VPN Plus there yourself, then open it from there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat das Kopieren in deinen Ordner „Programme“ nicht erlaubt. Ziehe VPN Plus selbst dorthin und öffne es von dort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas autorisé la copie dans votre dossier Applications. Glissez-y VPN Plus vous-même, puis ouvrez-le depuis là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がアプリケーションフォルダへのコピーを許可しませんでした。VPN Plus を手動でドラッグし、そこから開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许拷贝到“应用程序”文件夹。请自行将 VPN Plus 拖到那里，然后从那里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允許拷貝到「應用程式」檔案夾。請自行將 VPN Plus 拖到那裡，再從那裡開啟。"
          }
        }
      }
    },
    "macOS installed VPN Plus's network component but needs a restart before it can run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS installed VPN Plus's network component but needs a restart before it can run."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Netzwerkkomponente von VPN Plus installiert, braucht aber einen Neustart, bevor sie laufen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a installé le composant réseau de VPN Plus mais doit redémarrer avant qu'il puisse s'exécuter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS は VPN Plus のネットワークコンポーネントをインストールしましたが、実行には再起動が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已安装 VPN Plus 的网络组件，但需要重新启动才能运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已安裝 VPN Plus 的網路元件，但需要重新啟動才能執行。"
          }
        }
      }
    },
    "macOS needs your permission before VPN Plus can create a VPN connection. This happens once on this Mac.\n\nYou'll be asked to turn VPN Plus on in System Settings, to enter your Mac's password, and then to allow VPN Plus to add a VPN configuration.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS needs your permission before VPN Plus can create a VPN connection. This happens once on this Mac.\n\nYou'll be asked to turn VPN Plus on in System Settings, to enter your Mac's password, and then to allow VPN Plus to add a VPN configuration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS braucht deine Erlaubnis, bevor VPN Plus eine VPN-Verbindung erstellen kann. Das passiert einmal auf diesem Mac.\n\nDu wirst gebeten, VPN Plus in den Systemeinstellungen einzuschalten, das Passwort deines Macs einzugeben und dann VPN Plus zu erlauben, eine VPN-Konfiguration hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a besoin de votre autorisation avant que VPN Plus puisse créer une connexion VPN. Cela n'arrive qu'une fois sur ce Mac.\n\nIl vous sera demandé d'activer VPN Plus dans Réglages Système, de saisir le mot de passe de votre Mac, puis d'autoriser VPN Plus à ajouter une configuration VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus が VPN 接続を作成するには、macOS の許可が必要です。この Mac では一度だけ行われます。\n\nシステム設定で VPN Plus をオンにし、Mac のパスワードを入力し、その後 VPN Plus による VPN 構成の追加を許可するよう求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 创建 VPN 连接前需要 macOS 的许可。这在这台 Mac 上只需一次。\n\n系统会要求你在“系统设置”中开启 VPN Plus，输入 Mac 的密码，然后允许 VPN Plus 添加 VPN 配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Plus 建立 VPN 連線前需要 macOS 的許可。這在這台 Mac 上只需一次。\n\n系統會要求你在「系統設定」中開啟 VPN Plus，輸入 Mac 的密碼，然後允許 VPN Plus 加入 VPN 設定。"
          }
        }
      }
    },
    "macOS refused its network component. Download VPN Plus again and replace this copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused its network component. Download VPN Plus again and replace this copy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat seine Netzwerkkomponente abgelehnt. Lade VPN Plus erneut und ersetze diese Kopie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a refusé son composant réseau. Téléchargez VPN Plus à nouveau et remplacez cette copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がネットワークコンポーネントを拒否しました。VPN Plus をもう一度ダウンロードし、このコピーを置き換えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 拒绝了其网络组件。请重新下载 VPN Plus 并替换这份拷贝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 拒絕了其網路元件。請重新下載 VPN Plus 並取代這份拷貝。"
          }
        }
      }
    },
