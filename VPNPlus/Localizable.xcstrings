    "It didn't finish in time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It didn't finish in time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nicht rechtzeitig fertig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n'a pas abouti à temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内に完了しませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能及时完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能及時完成。"
          }
        }
      }
    },
    "It last connected %@ from a different network. Some servers only accept this Mac from the network they know it on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It last connected %@ from a different network. Some servers only accept this Mac from the network they know it on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt verbunden %@ aus einem anderen Netzwerk. Manche Server akzeptieren diesen Mac nur aus dem Netzwerk, aus dem sie ihn kennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière connexion %@ depuis un autre réseau. Certains serveurs n'acceptent ce Mac que depuis le réseau où ils le connaissent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回は %@、別のネットワークから接続しました。サーバーによっては、既知のネットワークからのこの Mac しか受け付けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次于%@从另一个网络连接。有些服务器只接受来自其已知网络的这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次於%@從另一個網路連線。有些伺服器只接受來自其已知網路的這台 Mac。"
          }
        }
      }
    },
    "It last connected %@ on %@. You're on %@ now — a different network interface, which some servers treat as a different device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It last connected %1$@ on %2$@. You're on %3$@ now — a different network interface, which some servers treat as a different device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt verbunden %1$@ über %2$@. Jetzt bist du über %3$@ verbunden – eine andere Netzwerkschnittstelle, die manche Server als anderes Gerät behandeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière connexion %1$@ via %2$@. Vous êtes maintenant en %3$@, une autre interface réseau, que certains serveurs traitent comme un autre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回は %1$@、%2$@ で接続しました。現在は %3$@ です。ネットワークインターフェースが異なるため、サーバーによっては別のデバイスとして扱われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次于%1$@通过%2$@连接。你现在使用的是%3$@——网络接口不同，有些服务器会将其视为另一台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次於%1$@透過%2$@連線。你現在使用的是%3$@——網路介面不同，有些伺服器會將其視為另一台裝置。"
          }
        }
      }
    },
    "It last connected %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It last connected %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt verbunden %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière connexion %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の接続は %@ です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次连接于%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次連線於%@。"
          }
        }
      }
    },
    "It needs your password, and VPN Plus wasn't running to ask for it. Connect once from VPN Plus and let it remember your password — after that, starting %@ from System Settings or the menu bar will work on its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs your password, and VPN Plus wasn't running to ask for it. Connect once from VPN Plus and let it remember your password — after that, starting %@ from System Settings or the menu bar will work on its own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es braucht dein Passwort, und VPN Plus lief nicht, um danach zu fragen. Verbinde einmal aus VPN Plus und lass es dein Passwort merken – danach funktioniert das Starten von %@ aus den Systemeinstellungen oder der Menüleiste von selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a besoin de votre mot de passe, et VPN Plus n'était pas ouvert pour le demander. Connectez-vous une fois depuis VPN Plus et laissez-le mémoriser votre mot de passe ; ensuite, démarrer %@ depuis Réglages Système ou la barre des menus fonctionnera tout seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが必要ですが、VPN Plus が起動しておらず確認できませんでした。一度 VPN Plus から接続してパスワードを記憶させると、以後はシステム設定やメニューバーから %@ を開始しても自動的に動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它需要你的密码，而 VPN Plus 当时未在运行，无法询问。请从 VPN Plus 连接一次并让它记住密码——之后从“系统设置”或菜单栏启动 %@ 就能自行工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它需要你的密碼，而 VPN Plus 當時未在執行，無法詢問。請從 VPN Plus 連線一次並讓它記住密碼——之後從「系統設定」或選單列啟動 %@ 就能自行運作。"
          }
        }
      }
    },
    "It stopped while %@, and didn't finish in time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stopped while %@, and didn't finish in time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es brach ab beim Schritt „%@“ und wurde nicht rechtzeitig fertig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela s'est arrêté pendant l'étape « %@ » et n'a pas abouti à temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の途中で停止し、時間内に完了しませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“%@”阶段停止，未能及时完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「%@」階段停止，未能及時完成。"
          }
        }
      }
    },
