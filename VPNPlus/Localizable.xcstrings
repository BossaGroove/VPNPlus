    "The server's certificate wasn't accepted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's certificate wasn't accepted"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat des Servers wurde nicht akzeptiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat du serveur n'a pas été accepté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの証明書が受け入れられませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器证书未被接受"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器憑證未被接受"
          }
        }
      }
    },
    "The server's security certificate wasn't accepted. This normally means something changed on the server, or this profile is out of date. Ask whoever supplied this profile whether it needs updating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's security certificate wasn't accepted. This normally means something changed on the server, or this profile is out of date. Ask whoever supplied this profile whether it needs updating."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat des Servers wurde nicht akzeptiert. Das bedeutet normalerweise, dass sich auf dem Server etwas geändert hat oder dieses Profil veraltet ist. Frag, wer dir dieses Profil gegeben hat, ob es aktualisiert werden muss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de sécurité du serveur n'a pas été accepté. Cela signifie normalement que quelque chose a changé sur le serveur, ou que ce profil est périmé. Demandez à la personne qui a fourni ce profil s'il doit être mis à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのセキュリティ証明書が受け入れられませんでした。通常、サーバー側で何かが変わったか、このプロファイルが古くなっています。プロファイルの提供者に更新が必要か確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的安全证书未被接受。这通常意味着服务器发生了变化，或此配置已过期。请询问提供此配置的人是否需要更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器的安全憑證未被接受。這通常表示伺服器有所變動，或此描述檔已過期。請詢問提供此描述檔的人是否需要更新。"
          }
        }
      }
    },
