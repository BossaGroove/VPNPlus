    "Nothing about this Mac has changed since it last connected, %@ — the same network, the same connection, the same address. That points at the server rather than at this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing about this Mac has changed since it last connected, %@ — the same network, the same connection, the same address. That points at the server rather than at this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An diesem Mac hat sich seit der letzten Verbindung %@ nichts geändert – gleiches Netzwerk, gleiche Verbindung, gleiche Adresse. Das deutet auf den Server hin, nicht auf diesen Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a changé sur ce Mac depuis sa dernière connexion, %@ : même réseau, même connexion, même adresse. Cela désigne le serveur plutôt que ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の接続(%@)以降、この Mac には変化がありません。同じネットワーク、同じ接続、同じアドレスです。原因はこの Mac ではなくサーバー側にあると考えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次连接（%@）以来，这台 Mac 没有任何变化——同一网络、同一连接、同一地址。问题更可能在服务器而不是这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次連線（%@）以來，這台 Mac 沒有任何變化——同一網路、同一連線、同一位址。問題比較可能在伺服器而不是這台 Mac。"
          }
        }
      }
    },
    "Nothing has been recorded for this profile yet. Connect once and the attempt appears here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been recorded for this profile yet. Connect once and the attempt appears here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Profil wurde noch nichts aufgezeichnet. Verbinde einmal, und der Versuch erscheint hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a encore été enregistré pour ce profil. Connectez-vous une fois et la tentative apparaîtra ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルの記録はまだありません。一度接続すると、その試行がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置尚无记录。连接一次后，尝试记录会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此描述檔尚無記錄。連線一次後，嘗試記錄會顯示在這裡。"
          }
        }
      }
    },
