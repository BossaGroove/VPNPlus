          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau fichier n'autorise pas l'enregistrement du mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいファイルではパスワードの保存が許可されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
